# Connexion à la MÊME base MySQL que Laravel (accès en LECTURE pour l'extraction
# des données ; le service n'écrit jamais directement dans les tables métier).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=si_intelligent
DB_USERNAME=root
DB_PASSWORD=

# Clé partagée avec Laravel (doit être identique à AI_SERVICE_API_KEY dans le .env Laravel)
AI_SERVICE_API_KEY=change-me

MODELS_STORE_PATH=./models_store
