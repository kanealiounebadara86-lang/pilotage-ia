# Copier ce fichier en ".env" sur le serveur puis remplacer les valeurs CHANGER.
# Ne JAMAIS publier le fichier .env.

# Nom de domaine qui pointe vers l'IP du serveur (ex : pilotage.duckdns.org)
DOMAIN=pilotage.exemple.com

# Clé de l'application : générer avec  echo "base64:$(openssl rand -base64 32)"
APP_KEY=base64:CHANGER

# Mots de passe MySQL : générer avec  openssl rand -hex 16
DB_PASSWORD=CHANGER
DB_ROOT_PASSWORD=CHANGER

# Clé partagée Laravel <-> service IA : générer avec  openssl rand -hex 24
AI_SERVICE_API_KEY=CHANGER

# Assistant et commandes vocales (clé Google AI Studio, à garder secrète)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
